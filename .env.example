# HomeBox environment — install.sh generates the real .env (mode 600) and
# never overwrites a value that already exists. This file documents what
# lives there; it holds no secrets.

# Written by install.sh from the machine itself
HB_ROOT=/opt/homebox
HB_DATA_DIR=/opt/homebox/data
HB_HOST_ADDRESS=
TZ=UTC
PUID=1000
PGID=1000

# Where each library actually lives. Blank = the default under HB_DATA_DIR.
# Editable in Settings -> Server Config -> Advanced. Keep them on ONE
# filesystem: a finished download is hardlinked into the library, and a
# hardlink cannot cross a mount point.
HB_MEDIA_MOVIES=
HB_MEDIA_TV=
HB_MEDIA_MUSIC=
HB_MEDIA_BOOKS=
HB_MEDIA_PHOTOS=
HB_DOWNLOADS=

# Backups are AES-256-GCM encrypted with this. An archive contains .env
# itself, so there is no unencrypted path - and losing this key means losing
# every archive taken with it.
HB_BACKUP_KEY=

# Generated once, per module that declares them in x-homebox.env_vars.
# Regenerating one is not harmless: n8n's key decrypts stored credentials,
# and Immich's password is baked into an initialised database.
FILEBROWSER_ADMIN_PASSWORD=
FILEBROWSER_JWT_SECRET=
IMMICH_DB_PASSWORD=
VAULTWARDEN_ADMIN_TOKEN=
LINKDING_ADMIN_PASSWORD=
N8N_ENCRYPTION_KEY=
